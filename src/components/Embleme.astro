---
/* Emblème « sous-jacent » — un carottage.
   Une sonde descend à travers quatre strates pour atteindre ce qui est dessous.
   Tracé volontairement irrégulier : les lignes ne sont ni parfaitement droites
   ni parfaitement parallèles, pour garder une main. */
const { taille = 28, classe = '' } = Astro.props;
---

<svg
  class={classe}
  width={taille}
  height={taille}
  viewBox="0 0 40 40"
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  role="img"
  aria-label="sous-jacent"
>
  <!-- les strates : de plus en plus appuyées à mesure qu'on descend -->
  <path d="M4.5 11.2 C 12 10.4, 27 10.9, 35.4 10.3" stroke-width="1.05" opacity="0.4" />
  <path d="M4.2 17.6 C 13 16.9, 26 17.4, 35.6 16.8" stroke-width="1.2" opacity="0.6" />
  <path d="M4.6 24.1 C 11 23.6, 28 24.1, 35.2 23.3" stroke-width="1.45" opacity="0.8" />
  <path d="M4.3 30.7 C 14 30.1, 25 30.6, 35.5 29.9" stroke-width="1.7" />

  <!-- la sonde, légèrement de biais -->
  <path d="M19.4 4.6 C 19.9 13, 20.1 22, 20.6 32.8" stroke-width="1.5" />
  <!-- la pointe -->
  <path d="M17.8 30.4 L 20.6 35.4 L 23.2 30.1" stroke-width="1.5" />
</svg>
