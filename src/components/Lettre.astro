---
/* Formulaire d'inscription à la lettre d'information.
   Plusieurs exemplaires peuvent coexister sur une même page : le script de
   Base.astro relie tous les formulaires portant la classe « lettre ».
   variante « pied » : dans le pied de page du site.
   variante « page » : bloc autonome dans le corps d'une page. */
const {
  id = 'lettre',
  variante = 'pied',
  titre = 'Recevoir les études',
  texte = "Un message à chaque publication : l'étude, sa note de suivi trimestrielle, et rien d'autre. Gratuit, sans contrepartie, désinscription en un clic.",
  bouton = "S'inscrire",
} = Astro.props;
---

<form class={`lettre lettre--${variante}`} id={id} novalidate>
  {titre && (
    <div class="lettre-texte">
      <h3>{titre}</h3>
      {texte && <p>{texte}</p>}
    </div>
  )}
  <div class="lettre-champ">
    <label class="visuellement-cache" for={`${id}-email`}>Votre adresse électronique</label>
    <input id={`${id}-email`} name="email" type="email" inputmode="email" autocomplete="email"
           placeholder="prenom@exemple.com" required />
    <button type="submit">{bouton}</button>
  </div>
  <p class="lettre-etat" id={`${id}-etat`} role="status" aria-live="polite"></p>
  <p class="lettre-rgpd">
    Votre adresse sert uniquement à l'envoi de ces publications et n'est ni revendue, ni cédée.
    <a href="/donnees-personnelles">Vos données</a>.
  </p>
</form>
