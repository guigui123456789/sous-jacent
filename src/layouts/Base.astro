---
import '../styles/global.css';
import Embleme from '../components/Embleme.astro';

const { titre, description, titreComplet, enteteTransparente = false, schema, image } = Astro.props;
const path = Astro.url.pathname;
const actif = (p) => (path === p || path.startsWith(p + '/') ? 'page' : undefined);
const annee = new Date().getFullYear();

const origine = (Astro.site ?? new URL('https://www.sousjacent.com')).origin;
const url = origine + path;

const AUTEUR = {
  '@type': 'Person',
  '@id': origine + '/a-propos/#personne',
  name: 'Guillaume Le Merour',
  url: origine + '/a-propos/',
  email: 'contact@sousjacent.com',
  sameAs: ['https://www.linkedin.com/in/guillaumelemerour'],
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Université Paris-Panthéon-Assas' },
    { '@type': 'CollegeOrUniversity', name: 'University of Maine at Augusta' },
  ],
  jobTitle: 'Étudiant en master de finance',
  knowsAbout: ['analyse financière', 'valorisation d\'entreprise', 'small caps', 'comptabilité IFRS'],
};

const EDITEUR = {
  '@type': 'Organization',
  '@id': origine + '/#editeur',
  name: 'Sous-jacent',
  alternateName: 'sousjacent.com',
  url: origine + '/',
  email: 'contact@sousjacent.com',
  logo: { '@type': 'ImageObject', url: origine + '/apple-touch-icon.png', width: 180, height: 180 },
  founder: { '@id': origine + '/a-propos/#personne' },
  description:
    "Publication indépendante d'analyse financière : les comptes d'une société cotée sur vingt et un exercices, retraités au même gabarit et publiés avec les données et le modèle.",
};

const SITE = {
  '@type': 'WebSite',
  '@id': origine + '/#site',
  url: origine + '/',
  name: 'sous-jacent',
  inLanguage: 'fr-FR',
  description:
    "L'analyse de sociétés cotées peu suivies : vingt et un exercices de comptes retraités au même gabarit, publiés avec les données brutes et le modèle de valorisation. La méthode, pas le verdict.",
  publisher: { '@id': AUTEUR['@id'] },
};

const graphe = [SITE, EDITEUR, AUTEUR, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])].map((n) =>
  n['@type'] === 'Article' || n['@type'] === 'TechArticle'
    ? { mainEntityOfPage: url, url, author: { '@id': AUTEUR['@id'] }, publisher: { '@id': AUTEUR['@id'] }, isPartOf: { '@id': SITE['@id'] }, inLanguage: 'fr-FR', ...n }
    : n
);
const donneesStructurees = JSON.stringify({ '@context': 'https://schema.org', '@graph': graphe });
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{titreComplet ?? `${titre} — sous-jacent`}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#162b4b" />
  <meta property="og:title" content={titre} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:url" content={new URL(path, Astro.site ?? "https://www.sousjacent.com")} />
  <meta property="og:site_name" content="sous-jacent" />
  <meta property="og:image" content={new URL(image ?? '/images/accueil-facade.webp', Astro.site ?? 'https://www.sousjacent.com')} />
  <meta property="og:image:alt" content={titre} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={titre} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(image ?? '/images/accueil-facade.webp', Astro.site ?? 'https://www.sousjacent.com')} />
  <meta name="author" content="Guillaume Le Merour" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <link rel="canonical" href={new URL(path, Astro.site ?? 'https://www.sousjacent.com')} />
  <script type="application/ld+json" is:inline set:html={donneesStructurees} />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="alternate" type="application/rss+xml" title="sous-jacent" href="/rss.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,300;0,400;1,300&family=Source+Sans+3:wght@400;600&display=swap"
  />
</head>
<body>
  <header class="site" id="entete" data-fond={enteteTransparente ? 'transparent' : 'verre'} data-mode={enteteTransparente ? 'hero' : 'fixe'}>
    <div class="enveloppe barre">
      <a class="marque" href="/">
        <Embleme taille={26} />
        <span>sous&#8209;jacent</span>
      </a>

      <button class="menu-bouton" type="button" aria-expanded="false" aria-controls="menu">Menu</button>

      <nav class="nav" id="menu">
        <a href="/etudes" aria-current={actif('/etudes')}>Les études</a>
        <a href="/mecanisme" aria-current={actif('/mecanisme')}>Le mécanisme</a>
        <a href="/fondamentaux" aria-current={actif('/fondamentaux')}>Les fondamentaux</a>
        <a href="/methode" aria-current={actif('/methode')}>La méthode</a>
        <a href="/a-propos" aria-current={actif('/a-propos')}>À propos</a>
      </nav>
    </div>
  </header>

  <main><slot /></main>

  <footer class="site">
    <div class="enveloppe">
      <div class="pied-haut">
        <div>
          <span class="pied-marque"><Embleme taille={26} /> sous-jacent</span>
          <p style="font-size:.9375rem;line-height:1.6;max-width:24rem">
            Les comptes d'une société cotée sur vingt et un exercices, retraités au même gabarit et
            publiés avec les données brutes et le modèle.
          </p>
        </div>

        <div>
          <h3>Les publications</h3>
          <ul>
            <li><a href="/etudes">Les études</a></li>
            <li><a href="/mecanisme">Le mécanisme de la semaine</a></li>
            <li><a href="/fondamentaux">Les fondamentaux</a></li>
          </ul>
        </div>

        <div>
          <h3>Découvrir</h3>
          <ul>
            <li><a href="/methode">La méthode</a></li>
            <li><a href="/a-propos">À propos</a></li>
            <li><a href="/rss.xml">Suivre par RSS</a></li>
          </ul>
        </div>

        <div>
          <h3>Travailler ensemble</h3>
          <ul>
            <li><a href="/a-propos">Le parcours</a></li>
            <li><a href="/a-propos">Télécharger le CV</a></li>
            <li><a href="mailto:contact@sousjacent.com">Écrire un message</a></li>
          </ul>
        </div>

        <div>
          <h3>Informations</h3>
          <ul>
            <li><a href="/informations-legales">Informations légales</a></li>
            <li><a href="/donnees-personnelles">Données personnelles</a></li>
            <li><a href="/cookies">Cookies</a></li>
            <li><a href="/vigilance-fraude">Vigilance fraude</a></li>
          </ul>
        </div>
      </div>

      <p class="pied-avert">
        <strong>Ceci n'est pas un conseil en investissement.</strong> Les contenus publiés ici ont une
        vocation pédagogique. Ils ne constituent ni une recommandation d'investissement, ni une
        incitation à acheter ou vendre un instrument financier, et ne tiennent compte d'aucune
        situation patrimoniale particulière. Aucun objectif de cours n'est publié. Aucune position
        n'est détenue sur les sociétés étudiées, et le site n'a aucune affiliation.
      </p>

      <div class="pied-bas">
        <span>{annee} sousjacent.com ©</span>
        <div class="pied-legal">
          <a href="/informations-legales">Informations légales</a>
          <a href="/cookies">Cookies</a>
          <a href="/donnees-personnelles">Données personnelles</a>
          <a href="/vigilance-fraude">Vigilance fraude</a>
        </div>
        <div class="pied-social">
          <a href="https://www.linkedin.com/in/guillaumelemerour" aria-label="LinkedIn" rel="me noopener" target="_blank">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM10 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.4c0-1.29-.02-2.95-1.8-2.95-1.8 0-2.08 1.4-2.08 2.85V21h-4z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var entete = document.getElementById('entete');
      var bouton = document.querySelector('.menu-bouton');
      var menu = document.getElementById('menu');

      if (bouton && menu) {
        bouton.addEventListener('click', function () {
          var ouvert = menu.getAttribute('data-ouvert') === 'oui';
          menu.setAttribute('data-ouvert', ouvert ? 'non' : 'oui');
          bouton.setAttribute('aria-expanded', ouvert ? 'false' : 'true');
          bouton.textContent = ouvert ? 'Menu' : 'Fermer';
        });
      }

      /* en-tête : transparent sur le hero, verre dépoli ensuite */
      if (entete && entete.getAttribute('data-mode') === 'hero') {
        var hero = document.querySelector('[data-hero]');
        var bascule = function () {
          var limite = hero ? hero.offsetHeight - 76 : 160;
          entete.setAttribute('data-fond', window.scrollY > limite ? 'verre' : 'transparent');
        };
        bascule();
        window.addEventListener('scroll', bascule, { passive: true });
        window.addEventListener('resize', bascule);
      }

      /* révélation au défilement, avec cascade */
      var aReveler = document.querySelectorAll('.reveler, .cadre-image');
      if (reduit || !('IntersectionObserver' in window)) {
        aReveler.forEach(function (el) { el.setAttribute('data-vu', 'oui'); });
      } else {
        var obs = new IntersectionObserver(function (entrees) {
          entrees.forEach(function (e) {
            if (!e.isIntersecting) return;
            var rang = parseInt(e.target.getAttribute('data-rang') || '0', 10);
            setTimeout(function () { e.target.setAttribute('data-vu', 'oui'); }, rang * 80);
            obs.unobserve(e.target);
          });
        }, { rootMargin: '0px 0px -10% 0px', threshold: 0.08 });
        aReveler.forEach(function (el) { obs.observe(el); });
      }

      /* chiffres clés : décompte à l'apparition */
      var compteurs = document.querySelectorAll('[data-compte]');
      if (compteurs.length) {
        if (reduit || !('IntersectionObserver' in window)) {
          compteurs.forEach(function (c) { c.textContent = c.getAttribute('data-compte'); });
        } else {
          var obsC = new IntersectionObserver(function (entrees) {
            entrees.forEach(function (e) {
              if (!e.isIntersecting) return;
              var el = e.target;
              var fin = parseInt(el.getAttribute('data-compte'), 10);
              var debut = performance.now();
              var duree = 1200;
              var pas = function (t) {
                var p = Math.min((t - debut) / duree, 1);
                var adouci = 1 - Math.pow(1 - p, 3);
                el.textContent = Math.round(fin * adouci);
                if (p < 1) requestAnimationFrame(pas);
                else el.textContent = fin;
              };
              requestAnimationFrame(pas);
              obsC.unobserve(el);
            });
          }, { threshold: 0.5 });
          compteurs.forEach(function (c) { obsC.observe(c); });
        }
      }
    })();
  </script>
</body>
</html>
