---
import '../styles/global.css';
const { titre, description } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{titre} — sous-jacent</title>
  <meta name="description" content={description} />
  <link rel="alternate" type="application/rss+xml" title="sous-jacent" href="/rss.xml" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" />
</head>
<body>
  <header class="site gutter">
    <div class="wrap bar">
      <a class="marque" href="/">sous&#8209;jacent<span>.</span></a>
      <nav>
        <a href="/mecanisme" aria-current={path.startsWith('/mecanisme') ? 'page' : undefined}>Le mécanisme</a>
        <a href="/etudes" aria-current={path.startsWith('/etudes') ? 'page' : undefined}>L'étude</a>
        <a href="/fondamentaux" aria-current={path.startsWith('/fondamentaux') ? 'page' : undefined}>Les fondamentaux</a>
        <a href="/methode" aria-current={path === '/methode' ? 'page' : undefined}>Méthode</a>
      </nav>
    </div>
  </header>

  <main><slot /></main>

  <footer class="site gutter">
    <div class="wrap">
      <div class="avert"><strong>Ceci n'est pas un conseil en investissement.</strong> Les contenus publiés ici ont une vocation pédagogique. Ils ne constituent ni une recommandation d'investissement, ni une incitation à acheter ou vendre un instrument financier, et ne tiennent compte d'aucune situation patrimoniale particulière.</div>
      <p style="margin-top:1.5rem">sous-jacent.com — écrit par Guillaume Le Mérour. <a href="/methode">Méthode</a> · <a href="/rss.xml">RSS</a></p>
    </div>
  </footer>
</body>
</html>
