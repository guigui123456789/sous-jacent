---
import '../styles/global.css';
import Embleme from '../components/Embleme.astro';

const { titre, description, titreComplet, enteteSurPhoto = false } = Astro.props;
const path = Astro.url.pathname;
const actif = (p) => (path === p || path.startsWith(p + '/') ? 'page' : undefined);
const annee = new Date().getFullYear();
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{titreComplet ?? `${titre} — sous-jacent`}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={titre} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="fr_FR" />
  <link rel="canonical" href={new URL(path, Astro.site ?? 'https://sousjacent.com')} />
  <link rel="alternate" type="application/rss+xml" title="sous-jacent" href="/rss.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,600;1,8..60,300&family=Source+Sans+3:wght@400;600&display=swap"
  />
</head>
<body>
  <header class="site gutter" id="entete" data-fond={enteteSurPhoto ? 'photo' : 'clair'} data-sur-photo={enteteSurPhoto ? 'oui' : 'non'}>
    <div class="wrap bar">
      <a class="marque" href="/">
        <Embleme taille={26} />
        <span>sous&#8209;jacent</span>
      </a>

      <button class="menu-bouton" type="button" aria-expanded="false" aria-controls="menu-principal">Menu</button>

      <nav class="principale" id="menu-principal">
        <a href="/etudes" aria-current={actif('/etudes')}>Les études</a>
        <a href="/mecanisme" aria-current={actif('/mecanisme')}>Le mécanisme</a>
        <a href="/fondamentaux" aria-current={actif('/fondamentaux')}>Les fondamentaux</a>
        <a href="/methode" aria-current={actif('/methode')}>La méthode</a>
        <a href="/a-propos" aria-current={actif('/a-propos')}>À propos</a>
      </nav>
    </div>
  </header>

  <main><slot /></main>

  <footer class="site gutter">
    <div class="wrap">
      <div class="pied-grille">
        <div>
          <span class="pied-marque"><Embleme taille={26} /> sous-jacent</span>
          <p style="max-width:28rem">
            Les comptes d'une société cotée française sur vingt et un exercices, retraités au même gabarit et publiés
            avec les données. Écrit par Guillaume Le Mérour.
          </p>
        </div>
        <div>
          <h3>Publications</h3>
          <ul>
            <li><a href="/etudes">Les études</a></li>
            <li><a href="/mecanisme">Le mécanisme de la semaine</a></li>
            <li><a href="/fondamentaux">Les fondamentaux</a></li>
          </ul>
        </div>
        <div>
          <h3>Le site</h3>
          <ul>
            <li><a href="/methode">La méthode</a></li>
            <li><a href="/a-propos">À propos</a></li>
            <li><a href="/rss.xml">Suivre par RSS</a></li>
          </ul>
        </div>
      </div>

      <p class="pied-avert">
        <strong style="color:#fff">Ceci n'est pas un conseil en investissement.</strong> Les contenus publiés ici ont
        une vocation pédagogique. Ils ne constituent ni une recommandation d'investissement, ni une incitation à
        acheter ou vendre un instrument financier, et ne tiennent compte d'aucune situation patrimoniale
        particulière. Aucun objectif de cours n'est publié.
      </p>

      <div class="pied-bas">
        <span>© {annee} sousjacent.com</span>
        <span>Aucune position détenue sur les sociétés étudiées. Aucune affiliation.</span>
      </div>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var entete = document.getElementById('entete');
      var bouton = document.querySelector('.menu-bouton');
      var menu = document.getElementById('menu-principal');

      if (bouton && menu) {
        bouton.addEventListener('click', function () {
          var ouvert = menu.getAttribute('data-ouvert') === 'oui';
          menu.setAttribute('data-ouvert', ouvert ? 'non' : 'oui');
          bouton.setAttribute('aria-expanded', ouvert ? 'false' : 'true');
          bouton.textContent = ouvert ? 'Menu' : 'Fermer';
        });
      }

      /* au-dessus d'une photo, l'en-tête est transparent et blanc ;
         dès qu'on quitte la photo, il repasse en crème */
      if (entete && entete.getAttribute('data-sur-photo') === 'oui') {
        var seuil = function () {
          var h = document.querySelector('[data-zone-photo]');
          return h ? h.offsetHeight - 80 : 200;
        };
        var majuscule = function () {
          entete.setAttribute('data-fond', window.scrollY > seuil() ? 'clair' : 'photo');
        };
        majuscule();
        window.addEventListener('scroll', majuscule, { passive: true });
        window.addEventListener('resize', majuscule);
      }

      /* révélation à l'approche, une seule fois par élément */
      var cibles = document.querySelectorAll('.monte');
      if (cibles.length && 'IntersectionObserver' in window) {
        var obs = new IntersectionObserver(function (entrees) {
          entrees.forEach(function (e) {
            if (e.isIntersecting) {
              e.target.setAttribute('data-vu', 'oui');
              obs.unobserve(e.target);
            }
          });
        }, { rootMargin: '0px 0px -12% 0px' });
        cibles.forEach(function (c) { obs.observe(c); });
      } else {
        cibles.forEach(function (c) { c.setAttribute('data-vu', 'oui'); });
      }
    })();
  </script>
</body>
</html>
