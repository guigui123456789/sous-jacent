---
import Base from '../layouts/Base.astro';
import Liste from '../components/Liste.astro';
import { getCollection } from 'astro:content';

const pub = (c) => c.filter((e) => !e.data.brouillon).sort((a, b) => b.data.date - a.data.date);
const meca = pub(await getCollection('mecanisme')).slice(0, 3);
const fonda = pub(await getCollection('fondamentaux')).slice(0, 4);
const etudes = pub(await getCollection('etudes'));
const etude = etudes[0];
---
<Base titre="Les mécanismes derrière les prix" description="Un fait de marché par semaine expliqué par sa mécanique, une étude d'entreprise par mois sur vingt-cinq ans de comptes.">
  <div class="hero gutter">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Marchés · mécanismes · comptes</p>
        <h1>Le prix est au-dessus.<br />Le <em>mécanisme</em> est dessous.</h1>
        <p class="col intro">Un fait de marché par semaine, expliqué par ce qui le produit. Une étude d'entreprise par mois, bâtie sur vingt-cinq ans de comptes. Et la méthode, écrite une fois, pour que vous puissiez refaire le calcul vous-même.</p>
      </div>
      <figure>
        <svg viewBox="0 0 320 170" role="img" aria-label="Une courbe de prix en surface, et en dessous les flux qui la déterminent">
          <text x="0" y="12" font-family="IBM Plex Mono, monospace" font-size="8" fill="var(--encre-douce)">SURFACE — le cours</text>
          <polyline points="0,42 40,34 80,46 120,28 160,37 200,22 240,33 280,18 320,26" fill="none" stroke="var(--encre)" stroke-width="1.6" />
          <line x1="0" y1="62" x2="320" y2="62" stroke="var(--filet)" stroke-width="1" stroke-dasharray="3 3" />
          <text x="0" y="78" font-family="IBM Plex Mono, monospace" font-size="8" fill="var(--accent)">SOUS-JACENT — ce qui le produit</text>
          <g fill="var(--accent-faible)" stroke="var(--accent)" stroke-width="1">
            <rect x="0" y="92" width="44" height="26" /><rect x="58" y="92" width="44" height="26" />
            <rect x="116" y="92" width="44" height="26" /><rect x="174" y="92" width="44" height="26" />
            <rect x="232" y="92" width="88" height="26" />
          </g>
          <g font-family="IBM Plex Mono, monospace" font-size="6.5" fill="var(--encre)" text-anchor="middle">
            <text x="22" y="108">marge</text><text x="80" y="108">BFR</text><text x="138" y="108">capex</text>
            <text x="196" y="108">dette</text><text x="276" y="108">anticipations</text>
          </g>
          <g stroke="var(--accent)" stroke-width="1" opacity=".55">
            <line x1="22" y1="92" x2="22" y2="66" /><line x1="80" y1="92" x2="80" y2="66" />
            <line x1="138" y1="92" x2="138" y2="66" /><line x1="196" y1="92" x2="196" y2="66" /><line x1="276" y1="92" x2="276" y2="66" />
          </g>
          <text x="0" y="145" font-family="IBM Plex Mono, monospace" font-size="7.5" fill="var(--encre-douce)">DCF inversé : quelle marge le marché doit-il supposer</text>
          <text x="0" y="157" font-family="IBM Plex Mono, monospace" font-size="7.5" fill="var(--encre-douce)">pour que le cours d'aujourd'hui tienne ?</text>
        </svg>
        <figcaption>La question de départ de chaque étude.</figcaption>
      </figure>
    </div>
  </div>

  <section class="gutter">
    <div class="wrap">
      <div class="section-head"><h2>Trois formats, un seul fil</h2></div>
      <div class="formats">
        <article class="format">
          <span class="cadence">Chaque lundi · ~800 mots</span>
          <h3>Le mécanisme de la semaine</h3>
          <p>Pas le résumé de l'actualité : un seul fait, et la mécanique qui l'a produit. Non pas « la BCE a baissé ses taux », mais pourquoi la courbe s'est pentifiée avant l'annonce.</p>
        </article>
        <article class="format">
          <span class="cadence">Mensuel · mémoire + 2 pages</span>
          <h3>L'étude</h3>
          <p>Une société cotée, vingt-cinq ans de bilans retraités au même gabarit. Small et mid caps françaises peu suivies, là où les comptes racontent encore quelque chose d'inédit.</p>
        </article>
        <article class="format">
          <span class="cadence">Au fil de l'eau</span>
          <h3>Les fondamentaux</h3>
          <p>Lire un compte de résultat, EBITDA contre free cash flow, ce que mesure vraiment le ROIC. La méthode écrite une fois, puis citée en note dans les études.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="gutter">
    <div class="wrap">
      <div class="section-head"><h2>Le mécanisme de la semaine</h2><a class="eyebrow" href="/mecanisme">Tous les numéros →</a></div>
      <Liste entrees={meca} base="/mecanisme" />
    </div>
  </section>

  {etude && (
    <section class="gutter">
      <div class="wrap">
        <div class="section-head"><h2>L'étude du mois</h2><a class="eyebrow" href="/etudes">Toutes les études →</a></div>
        <div class="etude">
          <div>
            <p class="eyebrow">n° {String(etude.data.numero).padStart(2, '0')} · {etude.data.societe}</p>
            <h3><a href={`/etudes/${etude.id}`} style="text-decoration:none">{etude.data.titre}</a></h3>
            <p>{etude.data.chapo}</p>
          </div>
          <div class="fiche">
            <div><span>Période couverte</span><span>{etude.data.periode}</span></div>
            <div><span>Société</span><span>{etude.data.societe}</span></div>
            {etude.data.isin && <div><span>ISIN</span><span>{etude.data.isin}</span></div>}
            <div><span>Scénarios</span><span>3</span></div>
            <div><span>Résumé</span><span>2 pages</span></div>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="gutter">
    <div class="wrap">
      <div class="section-head"><h2>Les fondamentaux</h2><a class="eyebrow" href="/fondamentaux">Tout voir →</a></div>
      <Liste entrees={fonda} base="/fondamentaux" />
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: 3.5rem 2.5rem; border-bottom: 1px solid var(--filet); }
  .hero h1 { font-size: clamp(2.2rem, 6vw, 3.6rem); line-height: 1.08; }
  .hero h1 :global(em) { font-style: italic; color: var(--accent); }
  .intro { margin-top: 1.1rem; font-size: 1.08rem; color: var(--encre-douce); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 2.5rem; align-items: end; }
  @media (max-width: 720px) { .hero-grid { grid-template-columns: 1fr; gap: 1.75rem; } }
  figure { margin: 0; }
  figcaption { font-family: var(--mono); font-size: .7rem; color: var(--encre-douce); margin-top: .5rem; }
  svg { max-width: 100%; height: auto; display: block; }
  .formats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--filet); }
  @media (max-width: 760px) { .formats { grid-template-columns: 1fr; } }
  .format { min-width: 0; padding: 1.5rem 1.4rem 1.6rem; border-bottom: 1px solid var(--filet); }
  .format + .format { border-left: 1px solid var(--filet); }
  @media (max-width: 760px) { .format + .format { border-left: 0; } }
  .format h3 { font-size: 1.18rem; margin-bottom: .45rem; }
  .format p { font-size: .93rem; color: var(--encre-douce); }
  .cadence { font-family: var(--mono); font-size: .72rem; color: var(--accent); letter-spacing: .06em; margin-bottom: .9rem; display: block; }
  .etude { background: var(--surface); border: 1px solid var(--filet); border-radius: 2px; padding: 1.75rem 1.5rem; display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 2rem; }
  @media (max-width: 760px) { .etude { grid-template-columns: 1fr; gap: 1.5rem; } }
  .etude h3 { font-size: 1.45rem; margin: .4rem 0 .7rem; }
  .etude p { color: var(--encre-douce); font-size: .95rem; }
  .fiche { font-family: var(--mono); font-size: .78rem; border-top: 1px solid var(--filet); }
  .fiche div { display: flex; justify-content: space-between; gap: 1rem; padding: .5rem 0; border-bottom: 1px solid var(--filet); font-variant-numeric: tabular-nums; }
  .fiche span:first-child { color: var(--encre-douce); }
  .section-head a { text-decoration: none; }
  .section-head a:hover { color: var(--accent); }
</style>
