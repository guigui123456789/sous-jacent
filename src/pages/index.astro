---
import Base from '../layouts/Base.astro';
import Liste from '../components/Liste.astro';
import { getCollection } from 'astro:content';

const publie = (c) => c.filter((e) => !e.data.brouillon).sort((a, b) => b.data.date - a.data.date);
const meca = publie(await getCollection('mecanisme')).slice(0, 4);
const fonda = publie(await getCollection('fondamentaux')).slice(0, 6);
const etudes = publie(await getCollection('etudes'));
const etude = etudes[0];
---

<Base
  titreComplet="sous-jacent — les comptes d'une société, vingt et un exercices, en public"
  titre="sous-jacent"
  description="Une société cotée française peu suivie, vingt et un exercices de comptes retraités au même gabarit, publiés avec les données et le modèle. La méthode, pas le verdict."
>
  <!-- ========== OUVERTURE ========== -->
  <div class="ouverture gutter">
    <div class="wrap ouverture-grille">
      <div class="ouverture-texte">
        <h1>Le cours est en surface.<br />Les comptes sont dessous.</h1>
        <p class="accroche">
          Une société cotée française peu suivie. Vingt et un exercices de bilans, retraités au même gabarit. Le modèle
          et les données se téléchargent avec l'étude, pour que vous puissiez refaire chaque calcul et changer les
          hypothèses.
        </p>
        <div class="ouverture-actions">
          <a class="bouton" href="/etudes">Voir les études</a>
          <a class="bouton creux" href="/methode">Comment c'est calculé</a>
        </div>
      </div>

      <figure class="ouverture-figure">
        <svg viewBox="0 0 340 230" role="img" aria-label="Au-dessus, la courbe du cours. En dessous, les postes de comptes qui la produisent : marge, besoin en fonds de roulement, investissements, dette, anticipations.">
          <g class="axe">
            <line x1="0" y1="84" x2="340" y2="84" />
          </g>

          <text class="legende" x="0" y="13">Le cours, ce qui se voit</text>
          <polyline
            class="courbe"
            points="0,52 38,42 76,58 114,33 152,46 190,26 228,40 266,20 304,31 340,18"
            fill="none"
          />

          <text class="legende cuivre" x="0" y="106">Les comptes, ce qui le produit</text>

          <g class="tiges">
            <line x1="30" y1="124" x2="30" y2="88" />
            <line x1="100" y1="124" x2="100" y2="88" />
            <line x1="170" y1="124" x2="170" y2="88" />
            <line x1="240" y1="124" x2="240" y2="88" />
            <line x1="305" y1="124" x2="305" y2="88" />
          </g>

          <g class="postes">
            <rect x="2" y="124" width="56" height="30" rx="2" />
            <rect x="72" y="124" width="56" height="30" rx="2" />
            <rect x="142" y="124" width="56" height="30" rx="2" />
            <rect x="212" y="124" width="56" height="30" rx="2" />
            <rect x="282" y="124" width="56" height="30" rx="2" />
          </g>

          <g class="etiquette">
            <text x="30" y="143">marge</text>
            <text x="100" y="143">BFR</text>
            <text x="170" y="143">capex</text>
            <text x="240" y="143">dette</text>
            <text x="310" y="143">attentes</text>
          </g>

          <g class="question">
            <text x="0" y="186">À quelle marge et à quelle croissance</text>
            <text x="0" y="203">le cours d'aujourd'hui oblige-t-il déjà à croire&nbsp;?</text>
          </g>
        </svg>
        <figcaption>La question qui ouvre chaque étude : un DCF inversé, pas un objectif de cours.</figcaption>
      </figure>
    </div>
  </div>

  <!-- ========== L'ÉTUDE ========== -->
  <section class="profond etude-bloc gutter">
    <div class="wrap">
      <div class="etude-entete">
        <h2>L'étude</h2>
        <p class="mesure">
          Les bureaux indépendants couvrent quatre cents valeurs, en surface, derrière un abonnement. Ici c'est
          l'inverse : une seule société, traitée en profondeur, tout montré, en accès libre.
        </p>
      </div>

      {etude ? (
        <article class="etude-vedette">
          <div class="etude-corps">
            <p class="label">
              Étude n° {String(etude.data.numero).padStart(2, '0')} — {etude.data.societe}
            </p>
            <h3><a href={`/etudes/${etude.id}`}>{etude.data.titre}</a></h3>
            <p class="etude-chapo">{etude.data.chapo}</p>
            <a class="bouton" href={`/etudes/${etude.id}`}>Lire l'étude</a>
          </div>
          <dl class="fiche">
            <div><dt>Période couverte</dt><dd class="chiffre">{etude.data.periode}</dd></div>
            <div><dt>Société</dt><dd>{etude.data.societe}</dd></div>
            {etude.data.isin && <div><dt>ISIN</dt><dd class="chiffre">{etude.data.isin}</dd></div>}
            <div><dt>Scénarios</dt><dd class="chiffre">3</dd></div>
            <div><dt>Résumé</dt><dd>2 pages, PDF</dd></div>
            <div><dt>Données</dt><dd>CSV téléchargeable</dd></div>
          </dl>
        </article>
      ) : (
        <div class="etude-attente">
          <p class="etude-attente-titre">
            La première étude est en préparation. Voici ce qu'elle contiendra.
          </p>
          <ul class="livrables">
            <li>
              <h3>Le mémoire</h3>
              <p>L'analyse complète, en six parties, du fait de départ jusqu'à ce que les comptes ne disent pas.</p>
            </li>
            <li>
              <h3>Le résumé de deux pages</h3>
              <p>La même étude ramenée à l'essentiel, en PDF, mise en page pour être imprimée et transmise.</p>
            </li>
            <li>
              <h3>Les comptes retraités</h3>
              <p>Vingt et un exercices en CSV, avec chaque retraitement documenté et chaque source datée.</p>
            </li>
            <li>
              <h3>Le DCF inversé</h3>
              <p>Trois curseurs — marge, croissance, coût du capital — et la valeur implicite qui bouge avec eux.</p>
            </li>
          </ul>
          <a class="bouton" href="/methode">Lire la méthode en attendant</a>
        </div>
      )}
    </div>
  </section>

  <!-- ========== MÉCANISME ========== -->
  {meca.length > 0 && (
    <section class="section gutter">
      <div class="wrap">
        <div class="section-tete">
          <div>
            <h2>Le mécanisme de la semaine</h2>
            <p class="mesure" style="color:var(--encre-douce);margin-top:.6rem">
              Un seul fait de marché, et la mécanique qui l'a produit. Huit cents mots, chaque lundi.
            </p>
          </div>
          <a class="lien" href="/mecanisme">Tous les numéros</a>
        </div>
        <Liste entrees={meca} base="/mecanisme" />
      </div>
    </section>
  )}

  <!-- ========== FONDAMENTAUX ========== -->
  {fonda.length > 0 && (
    <section class="section gutter">
      <div class="wrap">
        <div class="section-tete">
          <div>
            <h2>Les fondamentaux</h2>
            <p class="mesure" style="color:var(--encre-douce);margin-top:.6rem">
              Chaque retraitement est expliqué une fois ici, puis cité en note dans les études.
            </p>
          </div>
          <a class="lien" href="/fondamentaux">Tout voir</a>
        </div>
        <div class="fonda-grille">
          {fonda.map((f) => (
            <a class="fonda-carte" href={`/fondamentaux/${f.id}`}>
              <span class="fonda-rubrique">{f.data.rubrique}</span>
              <h3>{f.data.titre}</h3>
              <p>{f.data.chapo}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ========== MÉTHODE ========== -->
  <section class="section gutter">
    <div class="wrap">
      <div class="regles-grille">
        <div>
          <h2>Pourquoi aucun objectif de cours</h2>
          <p class="mesure" style="color:var(--encre-douce);margin-top:1rem">
            Publier un prix cible assorti d'un avis relève de la recommandation d'investissement au sens du règlement
            européen sur les abus de marché, avec les obligations qui vont avec. Le choix fait ici est différent :
            montrer la méthode et laisser le lecteur faire le calcul.
          </p>
          <a class="bouton creux" href="/methode" style="margin-top:1.5rem">La méthode en détail</a>
        </div>
        <ul class="regles">
          <li><strong>Des hypothèses écrites</strong> plutôt qu'un chiffre unique, et trois scénarios plutôt qu'un.</li>
          <li><strong>Le DCF inversé</strong> comme question d'ouverture : ce que le cours oblige déjà à croire.</li>
          <li><strong>Un seul gabarit de retraitement</strong>, pour que deux sociétés restent comparables.</li>
          <li><strong>Aucune affiliation</strong>, aucun contenu sponsorisé, aucune position sur les valeurs étudiées.</li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- ouverture ---------- */
  .ouverture {
    padding-block: clamp(3rem, 7vw, 6rem) clamp(3rem, 6vw, 5rem);
  }
  .ouverture-grille {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  @media (max-width: 860px) {
    .ouverture-grille { grid-template-columns: 1fr; gap: 2.5rem; }
  }
  .ouverture h1 {
    font-size: var(--t-3xl);
    line-height: 1.04;
    letter-spacing: -0.03em;
  }
  .accroche {
    margin-top: 1.5rem;
    max-width: 34rem;
    font-size: var(--t-md);
    line-height: 1.62;
    color: var(--encre-douce);
  }
  .ouverture-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    margin-top: 2rem;
  }

  .ouverture-figure { margin: 0; }
  .ouverture-figure svg { display: block; width: 100%; height: auto; overflow: visible; }
  .ouverture-figure figcaption {
    margin-top: 1rem;
    padding-top: .9rem;
    border-top: 1px solid var(--filet);
    font-size: var(--t-xs);
    color: var(--encre-douce);
    max-width: 26rem;
  }

  .ouverture-figure .legende {
    font-family: var(--sans);
    font-size: 9px;
    font-weight: 600;
    fill: var(--encre-douce);
  }
  .ouverture-figure .legende.cuivre { fill: var(--cuivre); }
  .ouverture-figure .axe line { stroke: var(--filet-fort); stroke-width: 1; stroke-dasharray: 2 4; }
  .ouverture-figure .courbe {
    stroke: var(--encre);
    stroke-width: 1.8;
    stroke-linejoin: round;
    stroke-linecap: round;
    stroke-dasharray: 420;
    stroke-dashoffset: 420;
    animation: tracer 1.5s cubic-bezier(.33, 1, .68, 1) .25s forwards;
  }
  .ouverture-figure .tiges line {
    stroke: var(--cuivre);
    stroke-width: 1;
    opacity: 0;
    animation: paraitre .5s ease forwards;
  }
  .ouverture-figure .tiges line:nth-child(1) { animation-delay: 1.15s; }
  .ouverture-figure .tiges line:nth-child(2) { animation-delay: 1.25s; }
  .ouverture-figure .tiges line:nth-child(3) { animation-delay: 1.35s; }
  .ouverture-figure .tiges line:nth-child(4) { animation-delay: 1.45s; }
  .ouverture-figure .tiges line:nth-child(5) { animation-delay: 1.55s; }
  .ouverture-figure .postes rect {
    fill: var(--cuivre-clair);
    stroke: var(--cuivre);
    stroke-width: 1;
    opacity: 0;
    animation: monter .5s cubic-bezier(.33, 1, .68, 1) forwards;
    transform-origin: center bottom;
  }
  .ouverture-figure .postes rect:nth-child(1) { animation-delay: 1.15s; }
  .ouverture-figure .postes rect:nth-child(2) { animation-delay: 1.25s; }
  .ouverture-figure .postes rect:nth-child(3) { animation-delay: 1.35s; }
  .ouverture-figure .postes rect:nth-child(4) { animation-delay: 1.45s; }
  .ouverture-figure .postes rect:nth-child(5) { animation-delay: 1.55s; }
  .ouverture-figure .etiquette text {
    font-family: var(--sans);
    font-size: 8.5px;
    font-weight: 500;
    fill: var(--encre);
    text-anchor: middle;
    opacity: 0;
    animation: paraitre .5s ease 1.7s forwards;
  }
  .ouverture-figure .question text {
    font-family: var(--serif);
    font-size: 12.5px;
    font-style: italic;
    fill: var(--encre-douce);
    opacity: 0;
    animation: paraitre .7s ease 1.95s forwards;
  }

  @keyframes tracer { to { stroke-dashoffset: 0; } }
  @keyframes paraitre { to { opacity: 1; } }
  @keyframes monter { from { opacity: 0; transform: scaleY(.4); } to { opacity: 1; transform: scaleY(1); } }

  @media (prefers-reduced-motion: reduce) {
    .ouverture-figure .courbe { stroke-dashoffset: 0; }
    .ouverture-figure .tiges line,
    .ouverture-figure .postes rect,
    .ouverture-figure .etiquette text,
    .ouverture-figure .question text { opacity: 1; transform: none; }
  }

  /* ---------- l'étude ---------- */
  .etude-bloc { padding-block: clamp(3.5rem, 7vw, 6rem); }
  .etude-entete { max-width: 44rem; margin-bottom: 3rem; }
  .etude-entete h2 { font-size: var(--t-2xl); }
  .etude-entete p { margin-top: 1rem; color: var(--profond-douce); font-size: var(--t-md); line-height: 1.6; }

  .etude-vedette {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    padding-top: 2.5rem;
    border-top: 1px solid var(--profond-filet);
  }
  @media (max-width: 820px) { .etude-vedette { grid-template-columns: 1fr; gap: 2rem; } }
  .etude-vedette h3 { font-size: var(--t-2xl); margin: .8rem 0 1rem; }
  .etude-vedette h3 a { text-decoration: none; }
  .etude-vedette h3 a:hover { color: var(--cuivre); }
  .etude-chapo { color: var(--profond-douce); font-size: var(--t-md); line-height: 1.6; max-width: 32rem; margin-bottom: 1.75rem; }

  .fiche { margin: 0; font-size: var(--t-sm); }
  .fiche > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: .7rem;
    border-bottom: 1px solid var(--profond-filet);
  }
  .fiche > div:first-child { border-top: 1px solid var(--profond-filet); }
  .fiche dt { color: var(--profond-douce); }
  .fiche dd { margin: 0; text-align: right; }

  /* état d'attente */
  .etude-attente { padding-top: 2.5rem; border-top: 1px solid var(--profond-filet); }
  .etude-attente-titre {
    font-family: var(--serif);
    font-size: var(--t-lg);
    line-height: 1.4;
    max-width: 30rem;
    margin-bottom: 2.5rem;
  }
  .livrables {
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 2rem 2.5rem;
  }
  .livrables h3 { font-size: var(--t-md); margin-bottom: .5rem; }
  .livrables p { color: var(--profond-douce); font-size: var(--t-sm); line-height: 1.6; }

  /* ---------- fondamentaux ---------- */
  .fonda-grille {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 1px;
    background: var(--filet);
    border: 1px solid var(--filet);
  }
  .fonda-carte {
    background: var(--papier);
    padding: 1.5rem 1.4rem 1.6rem;
    text-decoration: none;
    transition: background .18s ease;
  }
  .fonda-carte:hover { background: var(--sable); }
  .fonda-rubrique {
    display: block;
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--cuivre);
    margin-bottom: .6rem;
  }
  .fonda-carte h3 { font-size: var(--t-md); }
  .fonda-carte p { margin-top: .5rem; font-size: var(--t-sm); color: var(--encre-douce); line-height: 1.55; }

  /* ---------- règles ---------- */
  .regles-grille {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  @media (max-width: 820px) { .regles-grille { grid-template-columns: 1fr; gap: 2.5rem; } }
  .regles-grille h2 { font-size: var(--t-xl); }
  .regles { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--filet); }
  .regles li {
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--filet);
    font-size: var(--t-sm);
    color: var(--encre-douce);
    line-height: 1.6;
  }
  .regles strong { color: var(--encre); font-weight: 600; }
</style>
