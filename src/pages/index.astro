---
import Base from '../layouts/Base.astro';
import Embleme from '../components/Embleme.astro';
import { getCollection } from 'astro:content';

const publie = (c) => c.filter((e) => !e.data.brouillon).sort((a, b) => b.data.date - a.data.date);
const meca = publie(await getCollection('mecanisme'));
const fonda = publie(await getCollection('fondamentaux'));
const etudes = publie(await getCollection('etudes'));
const etude = etudes[0];

const recents = [...meca, ...fonda]
  .sort((a, b) => b.data.date - a.data.date)
  .slice(0, 4)
  .map((e) => ({
    titre: e.data.titre,
    chapo: e.data.chapo,
    lien: (e.data.rubrique ? '/fondamentaux/' : '/mecanisme/') + e.id,
    etiquette: e.data.rubrique ? `Les fondamentaux — ${e.data.rubrique}` : 'Le mécanisme de la semaine',
    date: e.data.date,
  }));
---

<Base
  titreComplet="sous-jacent — l'analyse d'une société cotée, vingt et un exercices, en public"
  titre="sous-jacent"
  description="Une société cotée française peu suivie, vingt et un exercices de comptes retraités au même gabarit, publiés avec les données et le modèle. La méthode, pas le verdict."
  enteteSurPhoto={true}
>
  <!-- ============ OUVERTURE ============ -->
  <section class="ouverture" data-zone-photo>
    <img
      class="ouverture-photo"
      src="/images/ouverture-feuillage.jpg"
      alt=""
      width="2400"
      height="1400"
      fetchpriority="high"
    />
    <div class="ouverture-voile"></div>
    <div class="ouverture-contenu gutter">
      <Embleme taille={54} classe="ouverture-embleme" />
      <h1>Ce que le cours<br />ne dit pas encore</h1>
      <p>
        Une société cotée française peu suivie, reprise exercice par exercice depuis 2005.
        Les comptes retraités, le modèle et les hypothèses sont publiés avec l'analyse.
      </p>
    </div>
    <a class="ouverture-suite" href="#publications" aria-label="Lire la suite">
      <span></span>
    </a>
  </section>

  <!-- ============ CE QUE JE PUBLIE ============ -->
  <section class="section gutter" id="publications">
    <div class="wrap">
      <div class="tete-centree monte">
        <p class="sur">Ce que je publie</p>
        <h2 class="section-titre">Une seule société, traitée en profondeur</h2>
        <p class="section-chapo">
          Les bureaux indépendants couvrent quatre cents valeurs, en surface, derrière un abonnement.
          Ici c'est l'inverse : une société à la fois, tout montré, en accès libre.
        </p>
      </div>

      <div class="trio">
        <article class="carte monte">
          <a href="/etudes">
            <img src="/images/feuillage-foret.jpg" alt="" width="1400" height="1000" loading="lazy" />
            <h3>L'étude</h3>
            <p>
              Vingt et un exercices de comptes repris et retraités au même gabarit, un DCF inversé,
              trois scénarios, et le fichier de données en téléchargement.
            </p>
            <span class="lien-carte">Voir les études</span>
          </a>
        </article>

        <article class="carte monte">
          <a href="/mecanisme">
            <img src="/images/cartes-anciennes.jpg" alt="" width="1400" height="1000" loading="lazy" />
            <h3>Le mécanisme</h3>
            <p>
              Un seul fait de marché par semaine, et la mécanique qui l'a produit. Pas le résumé de
              l'actualité : ce qui se passe dessous.
            </p>
            <span class="lien-carte">Lire les mécanismes</span>
          </a>
        </article>

        <article class="carte monte">
          <a href="/fondamentaux">
            <img src="/images/pages-anciennes.jpg" alt="" width="1400" height="1000" loading="lazy" />
            <h3>Les fondamentaux</h3>
            <p>
              Chaque retraitement expliqué une fois — loyers, non-récurrents, capital employé —
              puis cité en note dans les études.
            </p>
            <span class="lien-carte">Voir les fondamentaux</span>
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ CHIFFRES ============ -->
  <section class="chiffres gutter">
    <div class="wrap">
      <div class="chiffres-grille">
        <div class="monte">
          <span class="chiffre-valeur">2005</span>
          <p>Première année de la série, celle du passage obligatoire aux IFRS, pour que les comptes restent comparables.</p>
        </div>
        <div class="monte">
          <span class="chiffre-valeur">21</span>
          <p>Exercices repris un à un dans chaque étude, à partir des documents d'enregistrement universels.</p>
        </div>
        <div class="monte">
          <span class="chiffre-valeur">3</span>
          <p>Jeux d'hypothèses publiés côte à côte, avec ce que chacun suppose écrit noir sur blanc.</p>
        </div>
        <div class="monte">
          <span class="chiffre-valeur">0</span>
          <p>Objectif de cours. La méthode est montrée, la conclusion revient au lecteur.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ L'ÉTUDE ============ -->
  <section class="etude gutter">
    <div class="wrap etude-grille">
      <div class="etude-texte monte">
        <p class="sur">L'étude</p>
        <h2>{etude ? etude.data.titre : 'La première étude est en préparation'}</h2>
        <p class="etude-chapo">
          {etude
            ? etude.data.chapo
            : "Le gabarit d'analyse et le modèle de retraitement sont en construction. Voici ce que chaque étude contiendra."}
        </p>
        <a class="bouton" href={etude ? `/etudes/${etude.id}` : '/methode'}>
          {etude ? "Lire l'étude" : 'Lire la méthode'}
        </a>
      </div>

      <div class="etude-detail monte">
        {etude ? (
          <dl class="fiche">
            <div><dt>Société</dt><dd>{etude.data.societe}</dd></div>
            <div><dt>Exercices</dt><dd>{etude.data.periode}</dd></div>
            <div><dt>Résumé</dt><dd>2 pages, PDF</dd></div>
            <div><dt>Données</dt><dd>CSV téléchargeable</dd></div>
          </dl>
        ) : (
          <ul class="livrables">
            <li><strong>Le mémoire</strong> — l'analyse complète en six parties, du fait de départ jusqu'à ce que les comptes ne disent pas.</li>
            <li><strong>Le résumé de deux pages</strong> — en PDF, mis en page pour être imprimé et transmis.</li>
            <li><strong>Les comptes retraités</strong> — vingt et un exercices en CSV, chaque source datée.</li>
            <li><strong>Le DCF inversé</strong> — trois curseurs, et la valeur implicite qui bouge avec eux.</li>
          </ul>
        )}
      </div>
    </div>
  </section>

  <!-- ============ DERNIÈRES PUBLICATIONS ============ -->
  {recents.length > 0 && (
    <section class="section gutter">
      <div class="wrap">
        <div class="tete-ligne monte">
          <h2 class="section-titre" style="margin-bottom:0">Dernières publications</h2>
          <a class="lien" href="/mecanisme">Tout voir</a>
        </div>
        <div class="liste monte">
          {recents.map((r) => (
            <a class="item" href={r.lien}>
              <div>
                <span class="rubrique">{r.etiquette}</span>
              </div>
              <div>
                <h3>{r.titre}</h3>
                <p>{r.chapo}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ============ LA MÉTHODE ============ -->
  <section class="bandeau gutter">
    <div class="wrap bandeau-contenu monte">
      <p class="sur" style="color:#A9B8CC">La méthode, pas le verdict</p>
      <h2>Publier un prix cible, c'est vieillir en une semaine.<br />Publier une méthode, c'est se laisser contredire.</h2>
      <p class="bandeau-texte">
        Aucun objectif de cours n'est publié ici. Les hypothèses sont écrites et modifiables, les données
        se téléchargent, et chaque graphique renvoie au document et à la page dont il est tiré.
      </p>
      <a class="bouton clair" href="/methode">Comment c'est calculé</a>
    </div>
  </section>
</Base>

<style>
  /* ---------- ouverture ---------- */
  .ouverture {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .ouverture-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: respire 18s ease-out forwards;
  }
  @keyframes respire { from { transform: scale(1.06); } to { transform: scale(1); } }
  .ouverture-voile {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(10, 22, 38, .52) 0%, rgba(10, 22, 38, .3) 45%, rgba(10, 22, 38, .55) 100%);
  }
  .ouverture-contenu {
    position: relative;
    text-align: center;
    max-width: 58rem;
    padding-block: 8rem 4rem;
  }
  .ouverture-contenu :global(.ouverture-embleme) {
    color: #fff;
    margin: 0 auto 2.5rem;
    opacity: 0;
    animation: venir 1.1s cubic-bezier(.22, 1, .36, 1) .2s forwards;
  }
  .ouverture h1 {
    color: #fff;
    font-size: var(--d1);
    line-height: 1.06;
    letter-spacing: -0.02em;
    opacity: 0;
    animation: venir 1.2s cubic-bezier(.22, 1, .36, 1) .45s forwards;
  }
  .ouverture-contenu > p {
    margin: 2rem auto 0;
    max-width: 34rem;
    color: rgba(255, 255, 255, .88);
    font-size: var(--t-md);
    line-height: 1.65;
    opacity: 0;
    animation: venir 1.2s cubic-bezier(.22, 1, .36, 1) .75s forwards;
  }
  @keyframes venir { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: none; } }

  .ouverture-suite {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: 3.5rem;
    background: rgba(255, 255, 255, .35);
    overflow: hidden;
  }
  .ouverture-suite span {
    display: block;
    width: 1px;
    height: 100%;
    background: #fff;
    animation: glisse 2.6s ease-in-out infinite;
  }
  @keyframes glisse {
    0% { transform: translateY(-100%); }
    60%, 100% { transform: translateY(100%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ouverture-photo { animation: none; }
    .ouverture-contenu :global(.ouverture-embleme),
    .ouverture h1,
    .ouverture-contenu > p { opacity: 1; animation: none; }
    .ouverture-suite span { animation: none; }
  }

  /* ---------- têtes de section ---------- */
  .tete-centree {
    max-width: 44rem;
    margin: 0 auto 4.5rem;
    text-align: center;
  }
  .tete-centree .sur { display: block; margin-bottom: 1.5rem; }
  .tete-ligne {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }

  /* ---------- trois cartes ---------- */
  .trio {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3rem;
  }
  @media (max-width: 900px) { .trio { grid-template-columns: 1fr; gap: 3.5rem; } }
  .carte a { text-decoration: none; display: block; }
  .carte img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    margin-bottom: 2rem;
    transition: opacity .4s ease;
  }
  .carte a:hover img { opacity: .88; }
  .carte h3 { font-size: var(--d3); margin-bottom: 1rem; }
  .carte p { color: var(--gris); line-height: 1.65; }
  .lien-carte {
    display: inline-block;
    margin-top: 1.5rem;
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--nuit);
    border-bottom: 1px solid var(--filet-fort);
    padding-bottom: .35rem;
  }
  .carte a:hover .lien-carte { border-bottom-color: var(--nuit); }

  /* ---------- chiffres ---------- */
  .chiffres { padding-block: var(--pas); background: var(--creme-ombre); }
  .chiffres-grille {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 3rem;
  }
  @media (max-width: 900px) { .chiffres-grille { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.5rem; } }
  @media (max-width: 560px) { .chiffres-grille { grid-template-columns: 1fr; } }
  .chiffre-valeur {
    display: block;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(3rem, 2rem + 3.5vw, 4.5rem);
    line-height: 1;
    color: var(--nuit);
    margin-bottom: 1.25rem;
    font-variant-numeric: lining-nums;
  }
  .chiffres p { font-size: var(--t-sm); line-height: 1.6; color: var(--gris); }

  /* ---------- l'étude ---------- */
  .etude { padding-block: var(--pas); }
  .etude-grille {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }
  @media (max-width: 900px) { .etude-grille { grid-template-columns: 1fr; gap: 2.5rem; } }
  .etude-texte { max-width: 34rem; }
  .etude-texte .sur { display: block; margin-bottom: 1.5rem; }
  .etude h2 { font-size: var(--d2); }
  .etude-chapo { margin-top: 1.5rem; margin-bottom: 2.5rem; font-size: var(--t-md); line-height: 1.65; }
  .etude-detail { padding-top: .5rem; }

  .fiche { margin: 0; display: grid; grid-template-columns: 1fr; }
  .fiche > div { display: flex; justify-content: space-between; gap: 1rem; padding-block: .85rem; border-bottom: 1px solid var(--filet); }
  .fiche dt { color: var(--gris-clair); font-size: var(--t-sm); }
  .fiche dd { margin: 0; color: var(--nuit); font-size: var(--t-sm); }

  .livrables { list-style: none; margin: 0; padding: 0; }
  .livrables li { padding-block: 1.1rem; border-bottom: 1px solid var(--filet); font-size: var(--t-sm); line-height: 1.6; }
  .livrables li:first-child { border-top: 1px solid var(--filet); }
  .livrables strong { color: var(--nuit); font-weight: 600; }

  /* ---------- bandeau méthode ---------- */
  .bandeau { background: var(--nuit); padding-block: var(--pas); }
  .bandeau-contenu { max-width: 52rem; }
  .bandeau-contenu .sur { display: block; margin-bottom: 1.75rem; }
  .bandeau h2 { color: #fff; font-size: var(--d3); line-height: 1.22; }
  .bandeau-texte { margin: 2rem 0 2.75rem; color: #BFCBDA; font-size: var(--t-md); line-height: 1.65; max-width: 38rem; }
</style>
