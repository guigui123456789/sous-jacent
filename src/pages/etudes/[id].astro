---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entrees = await getCollection('etudes', (e) => !e.data.brouillon);
  return entrees.map((e) => ({ params: { id: e.id }, props: { e } }));
}
const { e } = Astro.props;
const { Content } = await render(e);
const d = new Date(e.data.date);
const affiche = d.toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' });

const schema = [
  {
    '@type': 'Article',
    headline: e.data.titre,
    description: e.data.chapo,
    datePublished: d.toISOString(),
    dateModified: d.toISOString(),
    articleSection: 'Les études',
    ...(e.data.partage
      ? { image: new URL(e.data.partage, Astro.site ?? 'https://www.sousjacent.com').href }
      : {}),
    about: {
      '@type': 'Corporation',
      name: e.data.societe,
      ...(e.data.isin ? { identifier: { '@type': 'PropertyValue', propertyID: 'ISIN', value: e.data.isin } } : {}),
    },
    temporalCoverage: e.data.periode.replace(/\s*–\s*/, '/'),
    isAccessibleForFree: true,
    inLanguage: 'fr-FR',
    keywords: [e.data.societe, 'analyse financière', 'comptes retraités', 'valorisation', 'DCF inversé', 'equity research'],
    ...(e.data.memoirePdf
      ? { associatedMedia: { '@type': 'MediaObject', encodingFormat: 'application/pdf', contentUrl: new URL(e.data.memoirePdf, Astro.site ?? 'https://www.sousjacent.com').href, name: `${e.data.titre} — étude complète au format PDF` } }
      : {}),
    citation: [
      'Vicor Corporation, formulaires 10-K 2005-2025, U.S. Securities and Exchange Commission, CIK 0000751978',
    ],
  },
  ...(e.data.donneesCsv
    ? [
        {
          '@type': 'Dataset',
          name: `${e.data.societe} — comptes retraités ${e.data.periode}`,
          description: `Comptes annuels de ${e.data.societe} repris et retraités au même gabarit sur la période ${e.data.periode}.`,
          creator: { '@id': (Astro.site ?? new URL('https://www.sousjacent.com')).origin + '/a-propos/#personne' },
          temporalCoverage: e.data.periode.replace(/\s*–\s*/, '/'),
          distribution: {
            '@type': 'DataDownload',
            encodingFormat: 'text/csv',
            contentUrl: new URL(e.data.donneesCsv, Astro.site ?? 'https://www.sousjacent.com').href,
          },
        },
      ]
    : []),
];
---

<Base titre={e.data.titre} description={e.data.chapo} image={e.data.partage} enteteTransparente={true} schema={schema}>
  <header class="tete" data-hero>
    <div class="tete-image">
      <img src="/images/tours-contreplongee.webp" alt="" fetchpriority="high" />
    </div>
    <div class="tete-voile"></div>
    <div class="enveloppe tete-contenu">
      <a class="retour" href="/etudes">Toutes les études</a>
      <p class="sur">Étude n° {String(e.data.numero).padStart(2, '0')} — {e.data.societe}</p>
      <h1>{e.data.titre}</h1>
      <p class="tete-chapo">{e.data.chapo}</p>
      <div class="tete-meta">
        <time datetime={d.toISOString()}>{affiche}</time>
        <span>Guillaume Le Merour</span>
        <span>{e.data.periode}</span>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="enveloppe grille-etude">
      <div class="corps"><Content /></div>

      <aside class="flanc">
        <div class="bloc">
          <h2>Fiche technique</h2>
          <dl>
            <div><dt>Société</dt><dd>{e.data.societe}</dd></div>
            {e.data.isin && <div><dt>ISIN</dt><dd>{e.data.isin}</dd></div>}
            <div><dt>Exercices</dt><dd>{e.data.periode}</dd></div>
            {e.data.cours && <div><dt>Cours de référence</dt><dd>{e.data.cours}</dd></div>}
          </dl>
        </div>

        {(e.data.memoirePdf || e.data.resumePdf || e.data.donneesCsv) && (
          <div class="bloc">
            <h2>À télécharger</h2>
            <ul class="fichiers">
              {e.data.memoirePdf && (
                <li><a href={e.data.memoirePdf}>L'étude complète, 30 pages <span>PDF</span></a></li>
              )}
              {e.data.resumePdf && (
                <li><a href={e.data.resumePdf}>Le résumé de deux pages <span>PDF</span></a></li>
              )}
              {e.data.donneesCsv && (
                <li><a href={e.data.donneesCsv}>Les comptes retraités <span>CSV</span></a></li>
              )}
            </ul>
          </div>
        )}

        <div class="bloc bloc--suivi">
          <h2>Le suivi de cette étude</h2>
          <p>
            Cette étude est revue après chaque publication trimestrielle de la société. Toute
            révision de la fourchette est inscrite ci-dessous, datée et motivée. Rien n'est
            corrigé en silence.
          </p>
          {e.data.prochaineRevue && (
            <p class="suivi-prochaine">Prochaine revue : <b>{e.data.prochaineRevue}</b></p>
          )}
          <ol class="suivi-journal">
            <li>
              <span class="suivi-date">17 octobre 2026</span>
              <span class="suivi-valeur">90 – 116 $, valeur centrale 102 $</span>
              <span class="suivi-motif">Publication initiale.</span>
            </li>
            {e.data.revisions.map((r) => (
              <li>
                <span class="suivi-date">{r.date}</span>
                <span class="suivi-valeur">{r.valeur}</span>
                <span class="suivi-motif">{r.motif}</span>
              </li>
            ))}
          </ol>
        </div>

        <div class="bloc bloc--note">
          <h2>Ce que cette étude ne fait pas</h2>
          <p>
            La fourchette publiée est le résultat d'hypothèses déclarées, pas un objectif de cours :
            ni horizon, ni avis d'achat ou de vente. Chaque hypothèse se déplace dans le calculateur,
            et la conclusion vous appartient.
          </p>
          <a class="lien" href="/methode">La méthode</a>
          <p class="bloc-version">Construite sous la méthode <a href="/documents/sous-jacent-methode-v1.0.pdf">version 1.0</a>.</p>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script>
  /* Calculateur de valorisation.
     Portage exact du moteur de outils/data.py : aux valeurs par défaut il
     redonne les 102 $ publiés et reproduit les vingt cases de la grille de
     sensibilité. Toute modification doit être reportée des deux côtés. */
  (function () {
    const racine = document.getElementById('calculateur');
    if (!racine) return;

    const CA2026 = 639.8;                                             // M$
    const CA2025 = 407.701;                                           // M$
    const BASE = [0.30, 0.22, 0.16, 0.12, 0.10, 0.08, 0.06, 0.05, 0.04];
    const MARGE_DEP = 0.26;
    const IMPOT = 0.21;
    const ACTIONS = 46.0;                                             // millions
    const TRESO_NETTE = 395.384;                                      // M$
    const COURS = 202.40;
    const DEFAUTS = { marge: 33, croissance: 1, wacc: 10, rotation: 2.6, g: 3 };

    function dcf(h) {
      const margeNorm = h.marge / 100;
      const wacc = h.wacc / 100;
      const g = h.g / 100;
      const croissance = BASE.map((c) => c * h.croissance);
      const n = croissance.length;
      let ca = CA2026;
      let caPrec = CA2026;
      let va = 0;

      for (let i = 0; i < n; i++) {
        ca = caPrec * (1 + croissance[i]);
        const m = MARGE_DEP + (margeNorm - MARGE_DEP) * (i + 1) / n;
        const nopat = ca * m * (1 - IMPOT);
        const reinv = (ca - caPrec) / h.rotation;
        va += (nopat - reinv) / Math.pow(1 + wacc, i + 1);
        caPrec = ca;
      }

      const nopatT = ca * margeNorm * (1 - IMPOT);
      const reinvT = ca * g / h.rotation;
      const vt = (nopatT - reinvT) * (1 + g) / (wacc - g);
      const vaVt = vt / Math.pow(1 + wacc, n);
      const ve = va + vaVt;

      return {
        ve,
        parAction: (ve + TRESO_NETTE) / ACTIONS,
        partVt: vaVt / ve * 100,
        caTerminal: ca,
      };
    }

    const nf = (v, d) => v.toLocaleString('fr-FR', {
      minimumFractionDigits: d, maximumFractionDigits: d,
    });

    const curseurs = Array.from(racine.querySelectorAll('input[type="range"]'));
    const sorties = {};
    ['marge', 'croissance', 'wacc', 'rotation', 'g', 'valeur', 'ecart', 'ca',
      'mult', 'vt', 've', 'barre'].forEach((cle) => {
      sorties[cle] = document.getElementById('o-' + cle);
    });

    function rendre() {
      const h = {};
      curseurs.forEach((c) => { h[c.dataset.cle] = parseFloat(c.value); });
      const r = dcf(h);

      sorties.marge.textContent = nf(h.marge, 1) + ' %';
      sorties.croissance.textContent = '×' + nf(r.caTerminal / CA2025, 1) + ' en dix ans';
      sorties.wacc.textContent = nf(h.wacc, 2).replace(/,?0+$/, '') + ' %';
      sorties.rotation.textContent = nf(h.rotation, 2) + ' fois';
      sorties.g.textContent = nf(h.g, 2).replace(/,?0+$/, '') + ' %';

      sorties.valeur.textContent = nf(r.parAction, 0);
      sorties.ca.textContent = nf(r.caTerminal, 0) + ' M$';
      sorties.mult.textContent = '×' + nf(r.caTerminal / CA2025, 1);
      sorties.vt.textContent = nf(r.partVt, 0) + ' %';
      sorties.ve.textContent = nf(r.ve, 0) + ' M$';

      const ecart = (r.parAction - COURS) / COURS * 100;
      sorties.ecart.textContent = Math.abs(ecart) < 0.5
        ? 'au niveau du cours observé'
        : nf(Math.abs(ecart), 0) + (ecart < 0 ? ' % sous le cours observé' : ' % au-dessus du cours observé');
      sorties.barre.style.width =
        Math.max(2, Math.min(100, r.parAction / COURS * 100)) + '%';
      racine.dataset.position = ecart < 0 ? 'sous' : 'au-dessus';
    }

    curseurs.forEach((c) => c.addEventListener('input', rendre));

    const reset = document.getElementById('c-reset');
    if (reset) {
      reset.addEventListener('click', function () {
        curseurs.forEach((c) => { c.value = String(DEFAUTS[c.dataset.cle]); });
        rendre();
      });
    }

    rendre();
  })();
</script>

<style>
  .tete { position: relative; display: flex; align-items: flex-end; overflow: hidden; min-height: 34rem; }
  @media (max-width: 760px) { .tete { min-height: 26rem; } }
  .tete-image { position: absolute; inset: 0; }
  .tete-image img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.08); animation: ample 14s var(--ease-ample) forwards; }
  @keyframes ample { to { transform: scale(1); } }
  .tete-voile { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(22,43,75,.8) 0%, rgba(22,43,75,.66) 40%, rgba(22,43,75,.9) 100%); }
  .tete-contenu { position: relative; width: 100%; padding-block: 8.5rem var(--e-12); }

  .retour { display: inline-block; margin-bottom: var(--e-9); font-size: .875rem; letter-spacing: .14em; text-transform: uppercase; color: rgba(255,255,255,.72); text-decoration: none; }
  .retour:hover { color: #fff; }
  .tete h1 { color: #fff; font-size: var(--h2); margin-top: var(--e-6); max-width: 22ch; }
  .tete-chapo { margin-top: var(--e-7); max-width: 38rem; color: rgba(255,255,255,.84); font-family: var(--serif); font-weight: 300; font-size: 1.375rem; line-height: 1.45; }
  .tete-meta { display: flex; gap: var(--e-8); flex-wrap: wrap; margin-top: var(--e-9); padding-top: var(--e-6); border-top: 1px solid rgba(255,255,255,.22); font-size: .875rem; color: rgba(255,255,255,.7); }

  .grille-etude { display: grid; grid-template-columns: minmax(0, 1fr) 20rem; gap: clamp(2.5rem, 6vw, 6rem); align-items: start; }
  @media (max-width: 1024px) { .grille-etude { grid-template-columns: 1fr; } .flanc { order: -1; } }
  .grille-etude .corps { margin-top: 0; max-width: none; }
  .grille-etude .corps > p,
  .grille-etude .corps > h2,
  .grille-etude .corps > h3,
  .grille-etude .corps > ul,
  .grille-etude .corps > ol,
  .grille-etude .corps > blockquote,
  .grille-etude .corps > .encadre,
  .grille-etude .corps > .sommaire-etude { max-width: 36rem; }
  .grille-etude .corps > table { max-width: 44rem; }
  .grille-etude .corps > figure { max-width: 52rem; }

  .flanc { position: sticky; top: 7rem; display: grid; gap: var(--e-9); }
  @media (max-width: 1024px) { .flanc { position: static; } }
  .bloc { border-top: 1px solid var(--bleu); padding-top: var(--e-5); }
  .bloc h2 { font-family: var(--sans); font-size: .875rem; font-weight: 400; letter-spacing: .18em; text-transform: uppercase; color: var(--graphite-80); margin-bottom: var(--e-6); }
  .bloc dl { margin: 0; }
  .bloc dl > div { display: flex; justify-content: space-between; gap: var(--e-5); padding-block: var(--e-3); border-bottom: 1px solid var(--graphite-20); font-size: .9375rem; }
  .bloc dt { color: var(--graphite-80); }
  .bloc dd { margin: 0; color: var(--bleu); text-align: right; }

  .fichiers { list-style: none; margin: 0; padding: 0; font-size: .9375rem; }
  .fichiers a { display: flex; justify-content: space-between; gap: var(--e-5); padding-block: var(--e-3); border-bottom: 1px solid var(--graphite-20); text-decoration: none; color: var(--bleu); }
  .fichiers a:hover { color: var(--or); }
  .fichiers span { color: var(--graphite-80); }

  .bloc--note p { font-size: .9375rem; line-height: 1.6; color: var(--graphite); margin-bottom: var(--e-6); }
</style>
