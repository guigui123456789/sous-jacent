---
import Base from '../../layouts/Base.astro';
import Liste from '../../components/Liste.astro';
import { getCollection } from 'astro:content';

const entrees = (await getCollection('etudes'))
  .filter((e) => !e.data.brouillon)
  .sort((a, b) => b.data.date - a.data.date);
---

<Base
  titre="Les études"
  description="Une société cotée française peu suivie, vingt et un exercices de comptes retraités au même gabarit, publiés avec les données."
>
  <div class="index-tete">
    <div class="enveloppe">
      <h1>Les études</h1>
      <p class="mesure intro">
        Une société à la fois, traitée en profondeur. Les comptes sont repris exercice par exercice depuis 2005,
        l'année du passage obligatoire aux IFRS, pour que la série reste homogène d'un bout à l'autre. Chaque étude
        paraît avec son résumé de deux pages et ses données.
      </p>
    </div>
  </div>

  <section class="section">
    <div class="enveloppe">
      {entrees.length > 0 ? (
        <Liste entrees={entrees} base="/etudes" />
      ) : (
        <div class="vide">
          <p class="vide-titre">La première étude n'est pas encore publiée.</p>
          <p class="mesure">
            Le gabarit d'analyse et le modèle de retraitement sont en construction. En attendant, la méthode est
            publique et les fondamentaux expliquent chaque retraitement qui sera utilisé.
          </p>
          <div class="vide-actions">
            <a class="bouton" href="/methode">Lire la méthode</a>
            <a class="bouton bouton--ligne" href="/fondamentaux">Voir les fondamentaux</a>
          </div>
        </div>
      )}
    </div>
  </section>
</Base>

<style>
  .index-tete { padding-bottom: 0; }
  .index-tete h1 { font-size: var(--h2); }
  .intro { margin-top: 1.2rem; font-size: 1.0625rem; line-height: 1.62; color: var(--graphite-80); }
  .vide { border-top: 1.5px solid var(--bleu); padding-top: 1.75rem; }
  .vide-titre { font-family: var(--serif); font-size: 1.375rem; line-height: 1.4; margin-bottom: .9rem; }
  .vide p { color: var(--graphite-80); }
  .vide-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.75rem; }
</style>
