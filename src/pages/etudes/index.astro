---
import Base from '../../layouts/Base.astro';
import EnTetePage from '../../components/EnTetePage.astro';
import Liste from '../../components/Liste.astro';
import { getCollection } from 'astro:content';

const entrees = (await getCollection('etudes'))
  .filter((e) => !e.data.brouillon)
  .sort((a, b) => b.data.date - a.data.date);
---

<Base
  titre="Les études"
  description="Les études de sous-jacent : une société cotée peu suivie, vingt et un exercices de comptes retraités au même gabarit, publiés avec les données brutes et le modèle."
  enteteTransparente={true}
>
  <EnTetePage
    sur="Analyse d'entreprise"
    titre="Les études"
    intro="Une société à la fois, traitée en profondeur. Les comptes sont repris exercice par exercice depuis 2005, l'année du passage obligatoire aux IFRS, pour que la série reste homogène d'un bout à l'autre."
    image="/images/tours-defense.webp"
  />

  <section class="section">
    <div class="enveloppe">
      {entrees.length > 0 ? (
        <Liste entrees={entrees} base="/etudes" />
      ) : (
        <div class="attente reveler">
          <div>
            <h2>La première étude n'est pas encore publiée</h2>
            <p class="attente-texte">
              Le gabarit d'analyse et le modèle de retraitement sont en construction. En attendant, la
              méthode est publique et les fondamentaux expliquent chaque retraitement qui sera utilisé.
            </p>
            <div class="attente-actions">
              <a class="bouton" href="/methode">Lire la méthode</a>
              <a class="bouton bouton--ligne" href="/fondamentaux">Voir les fondamentaux</a>
            </div>
          </div>
          <ul class="sommaire">
            <li><span class="rang">01</span><div><h3>Le fait de départ</h3><p>Ce qui, dans les comptes ou dans le cours, a motivé l'étude.</p></div></li>
            <li><span class="rang">02</span><div><h3>L'entreprise en vingt et un ans</h3><p>Ce que la série longue raconte, et ce qu'elle contredit.</p></div></li>
            <li><span class="rang">03</span><div><h3>Les comptes retraités</h3><p>Loyers capitalisés, non-récurrents neutralisés, capital employé reconstitué.</p></div></li>
            <li><span class="rang">04</span><div><h3>Ce que le cours oblige à croire</h3><p>Le DCF inversé, et la marge implicite comparée aux vingt et un exercices observés.</p></div></li>
            <li><span class="rang">05</span><div><h3>Une fourchette, et sa sensibilité</h3><p>Une seule fourchette de valeur, resserrée, et la grille qui montre ce que chaque hypothèse lui fait gagner ou perdre.</p></div></li>
            <li><span class="rang">06</span><div><h3>Ce que les comptes ne disent pas</h3><p>Les angles morts de l'analyse, et ce qu'il faudrait pour les lever.</p></div></li>
          </ul>
        </div>
      )}
    </div>
  </section>
</Base>

<style>
  .attente { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(2.5rem, 6vw, 6rem); align-items: start; }
  @media (max-width: 980px) { .attente { grid-template-columns: 1fr; gap: var(--e-10); } }
  .attente-texte { margin-top: var(--e-7); font-size: 1.0625rem; line-height: 1.6; }
  .attente-actions { display: flex; flex-wrap: wrap; gap: var(--e-5); margin-top: var(--e-9); }

  .sommaire { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--graphite-20); }
  .sommaire li { display: grid; grid-template-columns: 4rem minmax(0, 1fr); gap: var(--e-7); padding-block: var(--e-7); border-bottom: 1px solid var(--graphite-20); }
  .rang { font-family: var(--serif); font-weight: 300; font-size: 1.25rem; color: var(--or); }
  .sommaire h3 { font-size: 1.125rem; font-family: var(--serif); font-weight: 300; }
  .sommaire p { margin-top: .4rem; font-size: .9375rem; line-height: 1.55; color: var(--graphite-80); }
</style>
