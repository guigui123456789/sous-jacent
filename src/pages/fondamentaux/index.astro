---
import Base from '../../layouts/Base.astro';
import EnTetePage from '../../components/EnTetePage.astro';
import { getCollection } from 'astro:content';

const entrees = (await getCollection('fondamentaux'))
  .filter((e) => !e.data.brouillon)
  .sort((a, b) => b.data.date - a.data.date);

const rubriques = [...new Set(entrees.map((e) => e.data.rubrique))];
---

<Base
  titre="Les fondamentaux"
  description="Chaque retraitement expliqué une fois, puis cité en note dans les études."
  enteteTransparente={true}
>
  <EnTetePage
    sur="Les briques de méthode"
    titre="Les fondamentaux"
    intro="Distinguer l'EBITDA du free cash flow, remettre les loyers au bilan, comprendre ce que mesure le ROIC, actualiser des flux, calculer un coût du capital, lire une valeur terminale ou un cours à l'envers. Chacun est écrit une fois ici, puis cité en note dans les études plutôt que réexpliqué à chaque fois."
    image="/images/pantheon-fronton.webp"
  />

  {rubriques.map((r, ir) => (
    <section class={ir % 2 === 1 ? 'section section--pierre' : 'section'}>
      <div class="enveloppe">
        <div class="tete-ligne reveler">
          <h2>{r}</h2>
          <span class="compte">{entrees.filter((e) => e.data.rubrique === r).length} fiche{entrees.filter((e) => e.data.rubrique === r).length > 1 ? 's' : ''}</span>
        </div>
        <div class="grille-fiches">
          {entrees.filter((e) => e.data.rubrique === r).map((e, i) => (
            <a class="fiche-carte reveler" href={`/fondamentaux/${e.id}`} data-rang={i}>
              <h3>{e.data.titre}</h3>
              <p>{e.data.chapo}</p>
              <span class="fiche-fleche" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}
</Base>

<style>
  .compte { font-size: .875rem; letter-spacing: .14em; text-transform: uppercase; color: var(--graphite-80); }
  .grille-fiches { display: grid; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); gap: var(--e-8); }
  .fiche-carte {
    position: relative;
    display: block;
    padding: var(--e-8) var(--e-8) var(--e-12);
    background: var(--blanc);
    border: 1px solid var(--graphite-20);
    text-decoration: none;
    transition: transform .2s ease-out, box-shadow .2s ease-out;
  }
  .fiche-carte:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(22, 43, 75, .09); }
  .fiche-carte h3 { font-size: var(--h5); }
  .fiche-carte p { margin-top: var(--e-5); font-size: .9375rem; line-height: 1.6; color: var(--graphite); }
  .fiche-fleche {
    position: absolute;
    left: var(--e-8);
    bottom: var(--e-8);
    display: inline-flex;
    color: var(--or);
    transition: transform .2s ease-out;
  }
  .fiche-fleche svg { width: 1.5rem; height: 1.5rem; }
  .fiche-carte:hover .fiche-fleche { transform: translateX(5px); }
</style>
