---
import Base from '../layouts/Base.astro';
import EnTetePage from '../components/EnTetePage.astro';

/* Le CV reste vide tant que le PDF n'est pas déposé dans public/ :
   le bouton ne s'affiche pas et aucun lien ne tombe en 404. */
const cv = '';
const courriel = 'contact@sousjacent.com';
const linkedin = 'https://www.linkedin.com/in/guillaumelemerour';

const parcours = [
  {
    periode: '2026 — 2029',
    titre: 'Master de finance',
    lieu: 'Université Paris-Panthéon-Assas',
    detail:
      "Trois années : master 1, césure de deux stages de six mois, puis master 2. Gestion de portefeuille obligataire et actions, produits dérivés, évaluation d'actifs, analyse financière et finance d'entreprise. Séries temporelles, économétrie, optimisation dynamique. Python et VBA.",
  },
  {
    periode: '2025 — 2026',
    titre: 'Licence 3, finance internationale',
    lieu: 'University of Maine at Augusta, États-Unis',
    detail: "Année d'échange. Scolarité et travaux rendus en anglais.",
  },
  {
    periode: 'Été 2025',
    titre: 'Chargé de clientèle',
    lieu: 'CIC, Fouesnant',
    detail:
      "Quatre mois en agence : relation client, procédures financières et contraintes réglementaires vues du guichet plutôt que du manuel.",
  },
  {
    periode: 'Été 2024',
    titre: 'Auxiliaire de vacances',
    lieu: 'CIC, Fouesnant',
    detail: 'Trois mois en agence, premier contact avec le fonctionnement courant d\'une banque de détail.',
  },
];

const travaux = [
  {
    titre: 'Next Challenge 2026-2027',
    detail:
      "Compétition boursière étudiante organisée par Nextwise. Gestion d'un portefeuille en conditions réelles d'octobre à avril, évaluée par un jury de professionnels sur la diversification et la justification des choix autant que sur la performance.",
  },
  {
    titre: 'CME Group University Trading Challenge 2026',
    detail:
      "Chef d'équipe pour Paris-Panthéon-Assas. Quatre semaines de négociation de contrats à terme sur plateforme professionnelle simulée, face à plusieurs centaines d'équipes universitaires.",
  },
  {
    titre: 'Certifications Bloomberg',
    detail:
      'Bloomberg Market Concepts et Environmental Social Governance, obtenues en 2026.',
  },
];
---

<Base
  titre="À propos"
  description="Guillaume Le Merour, étudiant en master de finance. Pourquoi ce site existe et ce qu'on y trouve."
  enteteTransparente={true}
  schema={{ '@type': 'ProfilePage', mainEntity: { '@id': (Astro.site ?? new URL('https://www.sousjacent.com')).origin + '/a-propos/#personne' } }}
>
  <EnTetePage
    sur="À propos"
    titre="Guillaume Le Merour"
    intro="Étudiant en master de finance. J'écris ici l'analyse que j'aurais voulu lire en commençant : une société, ses comptes sur vingt et un exercices, et tout le chemin de calcul montré plutôt que résumé."
    image="/images/pantheon-dome.webp"
  />

  <section class="section">
    <div class="enveloppe apropos">
      <div class="reveler">
        <p class="sur">Pourquoi ce site</p>
        <h2>Occuper la place que personne ne prend</h2>
        <p class="texte">
          Les bureaux d'analyse couvrent des centaines de valeurs à la fois, pour des professionnels,
          derrière un abonnement : large, continu, forcément rapide sur chaque dossier. Une société y
          reçoit quelques heures par an. Il n'existe presque rien de public qui en prenne une seule et
          passe quinze heures dessus, en montrant tout le chemin de calcul.
        </p>
        <p class="texte">
          C'est l'espace que j'occupe. Je ne vends pas de la recherche, donc je peux me permettre la
          lenteur : reprendre les comptes depuis 2005, les retraiter ligne à ligne, et publier le
          fichier avec l'article.
        </p>
        <p class="texte">
          Je ne m'interdis aucune taille ni aucune place. Une petite valeur française peu suivie et
          une société du NASDAQ de douze milliards de dollars posent des questions différentes, et
          toutes deux m'intéressent. Le choix de chaque étude est le mien, assumé comme tel : je retiens
          la société dont vingt et un ans de comptes racontent quelque chose que le cours ne dit pas
          encore. La première est américaine ; rien ne dit que la suivante le sera.
        </p>
      </div>

      <aside class="carte-identite reveler" data-rang="1">
        <figure class="portrait">
          <img
            src="/images/portrait-guillaume.webp"
            alt="Portrait de Guillaume Le Merour"
            width="900"
            height="1100"
            loading="lazy"
          />
        </figure>
        <h3>En bref</h3>
        <dl>
          <div><dt>Formation</dt><dd>Master de finance, Paris-Panthéon-Assas</dd></div>
          <div><dt>Échange</dt><dd>University of Maine at Augusta</dd></div>
          <div><dt>Expérience</dt><dd>Deux étés en agence, CIC</dd></div>
          <div><dt>Terrain</dt><dd>Sociétés cotées, France et États-Unis</dd></div>
          <div><dt>Langues</dt><dd>Français, anglais</dd></div>
          <div><dt>Césure</dt><dd>Deux stages de six mois, à partir de juin 2027</dd></div>
          <div><dt>Recherche</dt><dd>Stages de césure, Paris, Londres ou Francfort</dd></div>
        </dl>
        <div class="actions">
          {cv && <a class="bouton" href={cv}>Télécharger le CV</a>}
          <a class="bouton bouton--ligne" href={`mailto:${courriel}`}>Écrire un message</a>
          {linkedin && <a class="bouton bouton--ligne" href={linkedin}>LinkedIn</a>}
        </div>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="enveloppe">
      <div class="reveler">
        <p class="sur">Parcours</p>
        <h2 class="parcours-titre">Où j'ai appris ce que j'écris</h2>
      </div>

      <ol class="parcours reveler" data-rang="1">
        {parcours.map((e) => (
          <li>
            <p class="parcours-periode">{e.periode}</p>
            <div>
              <h3>{e.titre}</h3>
              <p class="parcours-lieu">{e.lieu}</p>
              <p class="parcours-detail">{e.detail}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="travaux reveler" data-rang="2">
        <h3 class="travaux-titre">En cours</h3>
        <div class="travaux-grille">
          {travaux.map((t) => (
            <div class="travail">
              <h4>{t.titre}</h4>
              <p>{t.detail}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section section--pierre">
    <div class="enveloppe pourquoi">
      <div class="reveler">
        <p class="sur">Les limites que je me donne</p>
        <h2>Ce que je ne fais pas</h2>
      </div>
      <div class="reveler" data-rang="1">
        <p>
          Je publie une fourchette de valeur, parce qu'un calcul qui n'aboutit à rien ne se vérifie
          pas. Je ne publie en revanche ni objectif de cours, ni horizon, ni avis d'achat ou de vente :
          le chiffre sert à mesurer l'écart avec le marché, pas à dire quoi en faire. Je ne détiens
          aucune position sur les sociétés étudiées et n'ai aucune affiliation, ni courtier, ni
          sponsor. Les sociétés ne sont ni prévenues ni consultées.
        </p>
        <p>
          Ce que je publie est pédagogique : une méthode, des hypothèses explicites, et de quoi refaire
          le calcul autrement. <a href="/methode">La méthode est détaillée ici.</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section section--bleu">
    <div class="enveloppe recruteurs reveler">
      <div>
        <p class="sur">Pour les recruteurs</p>
        <h2>Chaque étude existe aussi en deux pages</h2>
        <p class="recruteurs-texte">
          En PDF, avec les comptes retraités en pièce jointe. C'est le format que j'envoie en
          candidature, et vous pouvez le télécharger directement depuis chaque étude. Je cherche
          actuellement mes deux stages de césure, à partir de juin 2027, en analyse financière ou en
          structuration — Paris, Londres ou Francfort.
        </p>
      </div>
      <a class="bouton bouton--clair" href="/etudes">Voir les études</a>
    </div>
  </section>
</Base>

<style>
  .apropos { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: clamp(2.5rem, 6vw, 6rem); align-items: start; }
  @media (max-width: 980px) { .apropos { grid-template-columns: 1fr; gap: var(--e-10); } }
  .apropos h2 { margin-top: var(--e-6); }
  .texte { margin-top: var(--e-7); line-height: 1.7; max-width: 40rem; }

  .carte-identite { background: var(--pierre-20); padding: var(--e-9); }
  .portrait { margin: calc(var(--e-9) * -1) calc(var(--e-9) * -1) var(--e-8); }
  .portrait img { display: block; width: 100%; height: auto; aspect-ratio: 9 / 11; object-fit: cover; }

  .carte-identite h3 { font-family: var(--sans); font-size: .875rem; font-weight: 400; letter-spacing: .18em; text-transform: uppercase; color: var(--graphite-80); margin-bottom: var(--e-7); }
  .carte-identite dl { margin: 0; }
  .carte-identite dl > div { display: flex; justify-content: space-between; gap: var(--e-7); padding-block: var(--e-4); border-bottom: 1px solid var(--graphite-20); }
  .carte-identite dl > div:first-child { border-top: 1px solid var(--graphite-20); }
  .carte-identite dt { color: var(--graphite-80); font-size: .9375rem; }
  .carte-identite dd { margin: 0; color: var(--bleu); font-size: .9375rem; text-align: right; }
  .actions { display: flex; flex-direction: column; gap: var(--e-3); margin-top: var(--e-9); }

  .pourquoi { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  @media (max-width: 980px) { .pourquoi { grid-template-columns: 1fr; gap: var(--e-9); } }
  .pourquoi h2 { margin-top: var(--e-6); }
  .pourquoi p { line-height: 1.7; max-width: 42rem; }
  .pourquoi p + p { margin-top: var(--e-7); }
  .pourquoi a { color: var(--bleu); border-bottom: 1px solid var(--bleu-40); text-decoration: none; }

  .recruteurs { display: flex; justify-content: space-between; align-items: flex-end; gap: var(--e-10); flex-wrap: wrap; }
  .recruteurs h2 { margin-top: var(--e-6); }
  .parcours-titre { margin-top: var(--e-6); }
  .parcours { list-style: none; margin: var(--e-10) 0 0; padding: 0; border-top: 1px solid var(--graphite-20); }
  .parcours li { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 4rem); padding-block: var(--e-8); border-bottom: 1px solid var(--graphite-20); }
  @media (max-width: 760px) { .parcours li { grid-template-columns: 1fr; gap: var(--e-3); } }
  .parcours-periode { font-family: var(--sans); font-size: .875rem; letter-spacing: .1em; text-transform: uppercase; color: var(--graphite-80); }
  .parcours h3 { font-family: var(--serif); font-weight: 300; font-size: 1.375rem; color: var(--bleu); }
  .parcours-lieu { margin-top: var(--e-2); font-size: .9375rem; color: var(--graphite-80); }
  .parcours-detail { margin-top: var(--e-5); line-height: 1.7; max-width: 42rem; }

  .travaux { margin-top: var(--e-11); }
  .travaux-titre { font-family: var(--sans); font-size: .875rem; font-weight: 400; letter-spacing: .18em; text-transform: uppercase; color: var(--graphite-80); }
  .travaux-grille { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: clamp(1.5rem, 4vw, 3rem); margin-top: var(--e-8); }
  .travail { padding-top: var(--e-6); border-top: 1px solid var(--or); }
  .travail h4 { font-family: var(--serif); font-weight: 300; font-size: 1.1875rem; color: var(--bleu); }
  .travail p { margin-top: var(--e-4); font-size: .9375rem; line-height: 1.65; }

  .recruteurs-texte { margin-top: var(--e-7); color: var(--bleu-20); line-height: 1.65; max-width: 36rem; }
</style>
