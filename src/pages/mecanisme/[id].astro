---
import Article from '../../layouts/Article.astro';
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entrees = await getCollection('mecanisme', (e) => !e.data.brouillon);
  return entrees.map((e) => ({ params: { id: e.id }, props: { e } }));
}
const { e } = Astro.props;
const { Content } = await render(e);
const graphique = e.data.format === 'graphique';
const d = new Date(e.data.date);
const affiche = d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---

{graphique ? (
  <Base
    titre={e.data.titre}
    description={e.data.chapo}
    image={e.data.partage}
    schema={{
      '@type': 'Article',
      headline: e.data.titre,
      description: e.data.chapo,
      datePublished: d.toISOString(),
      articleSection: 'Le graphique de la semaine',
      inLanguage: 'fr-FR',
    }}
  >
    <article class="article">
      <div class="enveloppe">
        <div class="article-tete">
          <a class="retour" href="/mecanisme/">Tous les mécanismes</a>
          <p class="sur">Le graphique de la semaine</p>
          <h1>{e.data.titre}</h1>
          <p class="chapo">{e.data.chapo}</p>
          <div class="article-meta">
            <time datetime={d.toISOString()}>{affiche}</time>
            <span>Guillaume Le Merour</span>
          </div>
        </div>

        <figure class="planche">
          <img src={e.data.image} alt={e.data.alt} loading="eager" />
          <figcaption>
            {e.data.lecture && <span class="planche-lecture">{e.data.lecture}</span>}
            <span class="source">{e.data.source}</span>
          </figcaption>
        </figure>

        <div class="corps"><Content /></div>

        {e.data.lien && (
          <p class="renvoi-note">
            <a href={e.data.lien}>{e.data.lienLibelle ?? 'Lire la suite'}</a>
          </p>
        )}

        <div class="article-pied">
          <p>
            Ce graphique est dessiné pour ce site à partir des documents cités. Il ne contient ni
            recommandation, ni objectif de cours. <a href="/methode/">Lire la méthode</a>.
          </p>
        </div>
      </div>
    </article>
  </Base>
) : (
  <Article
    titre={e.data.titre}
    chapo={e.data.chapo}
    date={e.data.date}
    fait={e.data.fait}
    rubrique="Le mécanisme de la semaine"
    retour="/mecanisme"
    retourLibelle="Tous les mécanismes"
  >
    <Content />
  </Article>
)}

<style>
  .article-tete { max-width: 46rem; }
  .article-tete .sur { margin-bottom: var(--e-6); }
  .retour { display: inline-block; margin-bottom: var(--e-8); font-size: .875rem; letter-spacing: .14em; text-transform: uppercase; text-decoration: none; color: var(--bleu); }
  .retour:hover { color: var(--or); }

  .planche { margin: var(--e-10) 0 0; padding: clamp(1.25rem, 3vw, 2.5rem); background: var(--pierre-20); }
  .planche img { display: block; width: 100%; height: auto; }
  .planche figcaption { margin-top: var(--e-6); display: grid; gap: var(--e-3); font-size: .875rem; line-height: 1.55; color: var(--graphite-80); }
  .planche .source { font-size: .8125rem; color: var(--graphite-80); opacity: .85; }
  .planche-lecture { color: var(--bleu); }

  .renvoi-note { max-width: 36rem; margin-top: var(--e-9); padding-top: var(--e-6); border-top: 1px solid var(--or); }
  .renvoi-note a { font-family: var(--serif); font-size: 1.0625rem; color: var(--bleu); }
  .renvoi-note a:hover { color: var(--or); }

  .article-pied { max-width: 36rem; margin-top: var(--e-12); padding-top: var(--e-6); border-top: 1px solid var(--graphite-20); font-size: .9375rem; color: var(--graphite-80); }
  .article-pied a { color: var(--bleu); }
</style>
