---
import Article from '../../layouts/Article.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entrees = await getCollection('mecanisme', (e) => !e.data.brouillon);
  return entrees.map((e) => ({ params: { id: e.id }, props: { e } }));
}
const { e } = Astro.props;
const { Content } = await render(e);
---

<Article
  titre={e.data.titre}
  chapo={e.data.chapo}
  date={e.data.date}
  fait={e.data.fait}
  rubrique="Le mécanisme de la semaine"
  retour="/mecanisme"
  retourLibelle="Tous les mécanismes"
>
  <Content />
</Article>
