---
import Base from '../../layouts/Base.astro';
import EnTetePage from '../../components/EnTetePage.astro';
import Liste from '../../components/Liste.astro';
import { getCollection } from 'astro:content';

const entrees = (await getCollection('mecanisme'))
  .filter((e) => !e.data.brouillon)
  .sort((a, b) => b.data.date - a.data.date);
---

<Base
  titre="Le mécanisme de la semaine"
  description="Un seul fait de marché par semaine, et la mécanique qui l'a produit. Huit cents mots, chaque lundi."
  enteteTransparente={true}
>
  <EnTetePage
    sur="Chaque lundi"
    titre="Le mécanisme de la semaine"
    intro="Pas un résumé de l'actualité : un seul fait, et ce qui l'a produit. Non pas « la banque centrale a baissé ses taux », mais pourquoi la courbe s'était déjà pentifiée avant l'annonce, et ce que cela dit des anticipations."
    image="/images/passant-mouvement.webp"
  />

  <section class="section">
    <div class="enveloppe"><Liste entrees={entrees} base="/mecanisme" /></div>
  </section>
</Base>
